<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SymphonyFrameWork/Editor/Administrator/UITK/SymphonyWIndow.uss?fileID=7433441132597879392&amp;guid=16c3f611d15eda644b63e276b16e6925&amp;type=3#SymphonyWIndow"/>
    <ui:VisualElement class="base">
        <ui:Button text="ドキュメント" name="button-document" class="document-button" />
        <ui:Label text="Save Data Registry" class="title"/>
        <ui:Label name="save-current-loader" text="Current Loader:" class="text" style="margin-top: 6px;"/>
        <ui:Label name="save-loaded-entries" text="Visible Entries:" class="text" style="margin-bottom: 8px;"/>

        <ui:VisualElement class="save-binding-row">
            <ui:VisualElement name="save-binding-lamp" class="save-binding-lamp save-binding--none"/>
            <ui:Label name="save-binding-state" text="No selection" class="text save-binding-state"/>
            <ui:Label name="save-binding-suffix" text="" class="text save-binding-suffix"/>
        </ui:VisualElement>
        <ui:Toggle name="save-carry-over" label="Play Mode へ持ち越す" class="text save-carry-over"/>

        <ui:Label text="Save Data Types" class="text" style="-unity-text-align: middle-left; width: 100%;"/>
        <ui:ListView name="save-cache-list" fixed-item-height="42" class="text" style="width: 100%; height: 180px; margin-top: 6px; margin-bottom: 8px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>

        <ui:VisualElement style="width: 100%; flex-direction: row; flex-wrap: wrap; margin-bottom: 8px;">
            <ui:Button name="save-load" text="Load" class="button" style="width: 32%; height: 32px;"/>
            <ui:Button name="save-save" text="Save" class="button" style="width: 32%; height: 32px;"/>
            <ui:Button name="save-delete" text="Delete" class="button" style="width: 32%; height: 32px;"/>
        </ui:VisualElement>

        <ui:Label text="Status" class="text" style="-unity-text-align: middle-left; width: 100%;"/>
        <ui:Label name="save-status" text="Save Data Types からセーブデータを選択してください。" class="text" style="-unity-text-align: upper-left; width: 100%; white-space: normal; margin-top: 4px; margin-bottom: 8px;"/>

        <ui:IMGUIContainer name="save-editor" style="width: 100%; height: 240px; min-height: 240px; max-height: 240px; flex-shrink: 0; overflow: hidden; margin-bottom: 10px;"/>
    </ui:VisualElement>
</ui:UXML>
