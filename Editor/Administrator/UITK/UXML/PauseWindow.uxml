<engine:UXML xmlns:engine="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SymphonyFrameWork/Editor/Administrator/UITK/SymphonyWIndow.uss?fileID=7433441132597879392&amp;guid=16c3f611d15eda644b63e276b16e6925&amp;type=3#SymphonyWIndow" />
    <engine:VisualElement class="base">
        <engine:Button text="ドキュメント" name="button-document" class="document-button" />
        <engine:Label text="PauseManager" class="title" />
        <engine:VisualElement style="height: 115px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
            <engine:Label text="Label" name="pause-text" class="text" style="height: 20px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 100%;" />
            <engine:VisualElement name="pause" style="width: 60px; height: 60px; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);" />
            <engine:Label text="Label" name="pausable-subscribers" class="text" style="height: 20px; margin-top: 4px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 100%;" />
        </engine:VisualElement>
        <engine:VisualElement style="height: 35px; width: 70%; flex-direction: row; align-content: center; justify-content: space-around;">
            <engine:Button text="Resume" name="button-resume" class="button text" style="width: 35%;" />
            <engine:Button text="Pause" name="button-pause" class="button text" style="width: 35%;" />
        </engine:VisualElement>
        <engine:Label text="Categories" name="category-title" class="text" style="height: 20px; margin-top: 10px; margin-right: 10px; margin-bottom: 0; margin-left: 10px; width: 100%;" />
        <engine:ListView name="category-list" virtualization-method="DynamicHeight" show-border="true" style="margin-top: 4px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; min-height: 80px; flex-grow: 1;" />
    </engine:VisualElement>
</engine:UXML>
