{
  "name": "symphonyframework",
  "version": "6.20.0",
  "displayName": "Symphony Framework",
  "description": "シーン遷移、サービス共有、セーブ、オーディオ、ポーズを同じ使い方で扱えるようにまとめたUnity向けフレームワークです。最初のシーンより前に自動で初期化されるため、Bootstrapシーンやマネージャープレハブを用意せずに、必要な機能から使い始められます。",
  "unity": "6000.0",
  "documentationUrl": "https://hibiki5201.github.io/SymphonyFramework/",
  "author": {
    "email": "takuto5201@gmail.com",
    "name": "HIBIKI_5201",
    "url": "https://pastoral-hovercraft-db7.notion.site/1544374a1f768079bac2f25b6a716cba?pvs=4"
  },
  "dependencies": {
    "com.unity.addressables": "2.9.1",
    "com.unity.inputsystem": "1.18.0",
    "com.unity.modules.audio": "1.0.0",
    "com.unity.modules.imgui": "1.0.0",
    "com.unity.modules.jsonserialize": "1.0.0",
    "com.unity.modules.uielements": "1.0.0",
    "com.unity.nuget.newtonsoft-json": "3.2.2",
    "com.unity.test-framework": "1.6.0"
  },
  "samples": [
    {
      "displayName": "Partitura Sample",
      "description": "サービスの登録、必須取得、非同期待機を行うPartitura（Service Locator）サンプルが含まれています。",
      "path": "Samples~/Runtime/PartituraSample"
    },
    {
      "displayName": "Manuscript Sample",
      "description": "Manuscript と SaveDataContent を使用したセーブデータ管理のサンプルが含まれています。",
      "path": "Samples~/Runtime/ManuscriptSample"
    },
    {
      "displayName": "Attacca Sample",
      "description": "Attacca を使用した追加ロード、優先度によるActive Scene切り替え、ロード完了待機のサンプルが含まれています。",
      "path": "Samples~/Runtime/AttaccaSample"
    },
    {
      "displayName": "Suite Sample",
      "description": "Suite を使用したブロック単位の依存順ロード、ブロック切り替え時の共有シーンの保持、Attacca による単体ロードとの共存のサンプルが含まれています。",
      "path": "Samples~/Runtime/SuiteSample"
    },
    {
      "displayName": "Fermata Sample",
      "description": "Fermata を使用したカテゴリーごとのポーズ切り替え、IPausable、ポーズ対応の待機処理のサンプルが含まれています。",
      "path": "Samples~/Runtime/FermataSample"
    },
    {
      "displayName": "Sonority Sample",
      "description": "Sonority を使用したAudioSource取得と音量制御のサンプルが含まれています。",
      "path": "Samples~/Runtime/SonoritySample"
    },
    {
      "displayName": "Debugger Sample",
      "description": "SymphonyDebugLogger のログ出力、SymphonyDebugHUD の表示と追加テキスト、SymphonyStopWatch の計測のサンプルが含まれています。",
      "path": "Samples~/Runtime/DebuggerSample"
    }
  ]
}
